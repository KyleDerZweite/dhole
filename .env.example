# Central server
NODE_ENV=development
DHOLE_HOST=127.0.0.1
DHOLE_PORT=4173
DHOLE_DATABASE=./data/dhole.db
DHOLE_PUBLIC_ORIGIN=http://127.0.0.1:4173
# Required in production: public, version-matched corresponding source.
# DHOLE_SOURCE_URL=https://github.com/your-org/dhole/tree/v0.1.0
DHOLE_ALLOWED_HOSTS=127.0.0.1,localhost

# Required in production. Each value is a base64-encoded 32-byte key.
# Generate one with: openssl rand -base64 32
# DHOLE_MASTER_KEY_ID=v1
# DHOLE_MASTER_KEYS={"v1":"paste-generated-key-here"}

# Gateway endpoints are administrator-configured but still host-allowlisted.
DHOLE_GATEWAY_ALLOWED_HOSTS=127.0.0.1,localhost

# Offline demo only. Never enable in production.
DHOLE_DEMO=false

# Node daemon (set after enrollment)
DHOLE_NODE_SERVER_URL=ws://127.0.0.1:4173/ws/node
DHOLE_NODE_STATE_DIR=./data/node
# DHOLE_NODE_DAEMON_VERSION=0.1.0
# DHOLE_NODE_HEARTBEAT_MS=15000
# DHOLE_NODE_MAX_FRAME_BYTES=1048576
# DHOLE_NODE_RECONNECT_MIN_MS=500
# DHOLE_NODE_RECONNECT_MAX_MS=30000
# DHOLE_NODE_MACHINE_ID=machine-id-returned-by-enrollment
# DHOLE_NODE_CREDENTIAL=credential-returned-by-enrollment
# DHOLE_NODE_REPOSITORIES={"repository-id":"/absolute/path/on-this-node"}
# DHOLE_NODE_SECRETS={"provider-secret-reference":"node-local-secret"}
# DHOLE_NODE_ENABLE_FAKE=false
# DHOLE_CODEX_EXECUTABLE=/absolute/path/to/codex
# DHOLE_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# DHOLE_KIMI_EXECUTABLE=/absolute/path/to/kimi
# DHOLE_OPENAI_BASE_URL=http://127.0.0.1:4000/v1
# DHOLE_OPENAI_MODEL=default
