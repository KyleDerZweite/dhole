# Copy to .env only if it does not already exist, then chmod 600 .env.
# These markers deliberately cannot start a production server.
# Keep secret values single-quoted when they contain $, #, or spaces.
DHOLE_PUBLIC_ORIGIN=REPLACE_WITH_PUBLIC_HTTPS_ORIGIN
DHOLE_ALLOWED_HOSTS=REPLACE_WITH_PUBLIC_HOSTNAME
DHOLE_MASTER_KEY_ID=REPLACE_WITH_KEY_ID
DHOLE_MASTER_KEYS='{"REPLACE_WITH_KEY_ID":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'
DHOLE_BOOTSTRAP_TOKEN=REPLACE_ME

# OPTIONAL: only used when compose.github.yaml is explicitly selected.
# Native Dhole accounts and local/Codeberg repositories need none of these.
# DHOLE_GITHUB_CLIENT_ID=REPLACE_WITH_GITHUB_CLIENT_ID
# DHOLE_GITHUB_CLIENT_SECRET=REPLACE_WITH_GITHUB_CLIENT_SECRET
# DHOLE_GITHUB_APP_ID=REPLACE_WITH_NUMERIC_GITHUB_APP_ID
# Host file path, mounted read-only by the optional override.
# DHOLE_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/REPLACE_WITH_GITHUB_APP.pem

# Optional comma-separated hostnames for the existing external CPA management API.
# Leave empty to deny outbound Gateway management requests until configured.
DHOLE_GATEWAY_ALLOWED_HOSTS=
# all, none, or comma-separated compiled module IDs. Core and access stay enabled.
DHOLE_MODULES=all

# Copy these three values from the Pangolin site's Newt configuration later.
PANGOLIN_ENDPOINT=REPLACE_WITH_PANGOLIN_HTTPS_ENDPOINT
NEWT_ID=REPLACE_WITH_NEWT_SITE_ID
NEWT_SECRET=REPLACE_WITH_NEWT_SITE_SECRET
